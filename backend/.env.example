DATABASE_URL=postgres://auditvault:auditvault@localhost:5432/auditvault?sslmode=disable
PORT=8080
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3000

JWT_SECRET=change_me_dev_only_32_bytes_min_change_me

# Pick one storage backend. Defaults to "r2".
#   r2  → Cloudflare R2 (S3-compatible, no egress fees)
#   s3  → AWS S3 (or any S3-compatible service like MinIO, Wasabi, B2)
STORAGE_PROVIDER=r2

# --- Cloudflare R2 ---
# Used when STORAGE_PROVIDER=r2.
# dashboard.cloudflare.com → R2: create a bucket and an API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=auditvault
R2_REGION=auto

# --- AWS S3 / S3-compatible ---
# Used when STORAGE_PROVIDER=s3.
# For real AWS, leave S3_ENDPOINT and S3_USE_PATH_STYLE empty.
# For MinIO / self-hosted, set both (e.g. S3_ENDPOINT=http://localhost:9000, S3_USE_PATH_STYLE=true).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=auditvault
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_USE_PATH_STYLE=

RESEND_API_KEY=
EMAIL_FROM=noreply@auditvault.local
