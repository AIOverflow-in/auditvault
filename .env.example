# Shared local-dev environment template.
# Copy to .env and adjust. Each service also has its own .env.example.

# Postgres (used by backend; docker-compose mounts the same DB locally)
POSTGRES_USER=auditvault
POSTGRES_PASSWORD=auditvault
POSTGRES_DB=auditvault
POSTGRES_PORT=5432

# URL the backend uses to reach Postgres
DATABASE_URL=postgres://auditvault:auditvault@localhost:5432/auditvault?sslmode=disable

# JWT signing key (HS256). Generate with: openssl rand -base64 32
JWT_SECRET=change_me_dev_only_32_bytes_min_change_me

# Cloudflare R2 (S3-compatible). Create a bucket + API token at
# dash.cloudflare.com → R2 and fill in the values below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=auditvault
R2_REGION=auto

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@auditvault.local

# CORS — origin the frontend runs on
FRONTEND_ORIGIN=http://localhost:3000

# Backend
PORT=8080
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
